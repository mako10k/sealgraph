  title "Experimental full-hex IDs, scoped tags, and link rationale work"
  state reached

milestone CONSISTENCY:
  title "External specification consistency gate passes"
  state reached

milestone MATERIAL_IDENTITY:
  title "Seal identity excludes compulsory event metadata"
  state reached

milestone FORMAT4_DESIGN:
  title "REF-independent branching revision contract accepted"
  state reached

milestone FORMAT3_DUMP:
  title "Format-3 logical dump is available"
  state reached

milestone FORMAT4_RUNTIME:
  title "Format-4 native repository works"
  state reached

milestone REVISION_DAG:
  title "Branching revision and Cause graph semantics work"
  state reached

milestone TAG_READY:
  title "Rename-safe format-4 tag namespace works"
  state reached

milestone FORMAT4_DOGFOOD:
  title "Tracked dogfood is explicitly converted to format 4"
  state reached

milestone USABLE:
  title "Dogfood usability and inspection contracts work"
  state reached

milestone DOGFOOD_R2:
  title "Recurring tracked dogfood passes"
  state reached

milestone READY:
  title "Standalone beta is ready for separately approved publication"
  state reached

milestone RECOVERY_DESIGN:
  title "Local REF recovery contract accepted"
  state reached

milestone RECOVERY_JOURNAL:
  title "Recovery journal and exact manifest primitives work"
  state reached

milestone RECOVERY_RUNTIME:
  title "Seal tag and move recovery work"
  state reached

milestone RECOVERY_READY:
  title "Issue 12 local recovery acceptance passes"
  state reached

milestone CAUSE_REVISION_DESIGN:
  title "Cause-scoped revision and Universal Blob ADR set is accepted"
  state reached

milestone CAUSE_REVISION_FORMAT:
  title "Universal Blob format and incompatible migration boundary work"
  state reached

milestone CAUSE_REVISION_RUNTIME:
  title "Cause-scoped graph and format-5 public runtime work"
  state reached

milestone CAUSE_REVISION_READY:
  title "Cause-scoped revision normative and runtime acceptance passes"
  state reached

milestone LINK_METADATA_DESIGN:
  title "Format-6 Cause Link metadata ADR set is accepted"
  state reached

milestone FORMAT6_METADATA_STORAGE:
  title "Format-6 metadata storage and migration primitives work"

milestone FORMAT6_METADATA_RUNTIME:
  title "Format-6 metadata CLI and inspection runtime works"

milestone FORMAT6_METADATA_READY:
  title "Format-6 metadata normative and runtime acceptance passes"

task FORMAT_SPEC START -> FORMAT:
  title "Lock canonical payload, REF grammar, and object IDs"
  duration 2p
  status done

task NATIVE_SLICE FORMAT -> NATIVE:
  title "Implement standalone init/add/link/seal/show/status"
  duration 5p
  status done

task DOGFOOD_HERMETIC NATIVE -> DOGFOOD_R0:
  title "Exercise Phase 1 in a temporary repository"
  duration 1p
  status done

task GRAPH_ENGINE DOGFOOD_R0 -> GRAPH:
  title "Implement DAG validation, stale propagation, and impact"
  duration 4p
  status done

task RUNTIME_BOOTSTRAP GRAPH -> RUNTIME:
  title "Bootstrap ignored runtime directories from canonical checkout"
  duration 1p
  status done

task DOGFOOD_TRACKED RUNTIME -> DOGFOOD_R1:
  title "Add explicitly approved tracked project provenance"
  duration 1p
  status done

task NATIVE_V2_SLICE HISTORY_READY -> NATIVE_V2:
  title "Implement ADR 0006 and seal its dogfood provenance"
  duration 4p
  status done

task EXTERNAL_SPEC_GATE NATIVE_V2 -> CONSISTENCY:
  title "Accept and enforce publication, draft, candidate, and safe-output contracts"
  duration 5p
  status done

task MATERIAL_IDENTITY_V3 CONSISTENCY -> MATERIAL_IDENTITY:
  title "Implement ADR 0009 and regenerate tracked format-3 provenance"
  duration 3p
  status done

task ADR11_DESIGN MATERIAL_IDENTITY -> FORMAT4_DESIGN:
  title "Accept REF-independent Seals, branching revisions, and Git tree-view boundary"
  duration 2p
  status done

task FORMAT3_LOGICAL_DUMP FORMAT4_DESIGN -> FORMAT3_DUMP:
  title "Add deterministic read-only format-3 logical dump"
  duration 3p
  status done

task FORMAT4_NATIVE_CORE FORMAT3_DUMP -> FORMAT4_RUNTIME:
  title "Implement format-4 canonical Seal, candidate, selector, and dump/load core"
  duration 6p
  status done

task FORMAT4_REVISION_GRAPH FORMAT4_RUNTIME -> REVISION_DAG:
  title "Implement active revision DAG, derive/add-parent, stale cache/scan, history, and impact"
  duration 6p
  status done

task TAG_CONTRACT REVISION_DAG -> TAG_READY:
  title "Resolve rename-safe format-4 tag namespace and REF mv transaction (SG-BL-010)"
  duration 2p
  status done

task FORMAT4_DOGFOOD_LOAD TAG_READY -> FORMAT4_DOGFOOD:
  title "Convert tracked dogfood by explicit dump/load and exercise a sibling revision"
  duration 2p
  status done

task CONTENT_INGEST FORMAT4_DOGFOOD -> USABLE:
  title "Add exact file input and deterministic manifests (SG-BL-001/002)"
  duration 3p
  status done

task HISTORY_INSPECTION DOGFOOD_R1 -> HISTORY_READY:
  title "Add log, linklog, and semantic diff (SG-BL-003/004)"
  duration 4p
  status done

task OPERATOR_CONTRACT FORMAT4_DOGFOOD -> USABLE:
  title "Clarify semantics, output, and link-message editing (SG-BL-005/006/007/011)"
  duration 3p
  status done

task DOGFOOD_RECURRING USABLE -> DOGFOOD_R2:
  title "Exercise recurring tracked workflow (SG-BL-008)"
  duration 1p
  status done

task RELEASE_GATE DOGFOOD_R2 -> READY:
  title "Close standalone-only v0.1.0-beta.1 with fsck and release checks"
  duration 3p
  status done

task RECOVERY_CONTRACT READY -> RECOVERY_DESIGN:
  title "Accept ADR 0018 and freeze the recovery acceptance matrix"
  duration 2p
  status done
  source "Issue 12 and ADR 0018"

task RECOVERY_CORE RECOVERY_DESIGN -> RECOVERY_JOURNAL:
  title "Implement exact manifest CAS and crash-safe local recovery journal"
  duration 5p
  status done
  source "ADR 0018 manifest transitions and publication"

task RECOVERY_SEAL_TAG RECOVERY_JOURNAL -> RECOVERY_RUNTIME:
  title "Integrate and recover single-manifest seal and tag operations"
  duration 4p
  status done
  source "Issue 12 seal tag and intervening mutation acceptance"

task RECOVERY_MOVE RECOVERY_JOURNAL -> RECOVERY_RUNTIME:
  title "Integrate and recover atomic REF move operations"
  duration 3p
  status done
  source "ADR 0018 atomicity limit"

task RECOVERY_ACCEPTANCE RECOVERY_RUNTIME -> RECOVERY_READY:
  title "Add recovery CLI JSON fault tests and complete Issue 12 acceptance"
  duration 3p
  status done
  source "ADR 0018 acceptance gate"

task CAUSE_REVISION_CONTRACT RECOVERY_READY -> CAUSE_REVISION_DESIGN:
  title "Accept Cause-scoped revision, Universal Blob, migration, and public interface contracts"
  description "Review and accept ADRs 0023, 0025, 0026, and 0027 covering manifest-coherent Cause-scoped observation, all-observer and explicitly filtered impact, unique-node branching log, edge-wise linklog, minimal typed Blob instances, exact format-5 Candidate bytes, one-target authoring, exact inspection schema successors, explicit loss of unobserved format-4 parent meaning, deterministic warning and receipt, exact export observation and durability, and no ordinary runtime compatibility layer while retaining ADR 0024 source-adapter separation."
  duration 3p
  status done
  source "Operator direction and ADRs 0023 through 0027"

task CAUSE_REVISION_FORMAT_SLICE CAUSE_REVISION_DESIGN -> CAUSE_REVISION_FORMAT:
  title "Implement Universal Blob canonical format and isolated migration"
  description "Add the accepted Seal, Material, Provenance, and exact Candidate schemas; scalar-exact canonical JSON and typed Blob validation; target-normalized Cause assertions; double-captured format-4 dump with Kahn ordering and explicit exclusions; migration-only old-payload verification; format-5 load with file/directory/parent durability; collapse and unobserved-parent warnings; fully canonical durable receipts; load-receipt recovery; and fixed fixtures without a dual repository reader."
  duration 6p
  status done
  source "ADRs 0023, 0025, 0026, and 0027 after acceptance"

task CAUSE_REVISION_RUNTIME_SLICE CAUSE_REVISION_FORMAT -> CAUSE_REVISION_RUNTIME:
  title "Implement Cause-derived graph and Universal Blob runtime semantics"
  description "Replace intrinsic-parent algorithms coherently; implement exact-manifest observations and conditional Seal inventories, observed-closure selectors, explicit two-selector compare, publication-baseline candidate compare, unique-node bounded log/v2, impact/v2 with repeatable asserted-by filtering, edge-wise linklog/v2, all affected inspection successors including status/v3, one-target whole-record authoring, assertion-aware indexes, CLI and cache changes; and pass format-5 graph, typed-Blob, migration-readback, and no-automatic-repair acceptance."
  duration 8p
  status done
  source "ADRs 0023, 0025, 0026, and 0027 after acceptance"

task CAUSE_REVISION_NORMATIVE_SYNC CAUSE_REVISION_RUNTIME -> CAUSE_REVISION_READY:
  title "Synchronize format-5 normative and public contracts"
  description "Update requirements, architecture, storage-format, CLI, integrations, documentation index, runtime help, and completion from the accepted ADR bytes; bind fixed format-5 canonical and inspection JSON fixtures; remove contradictory format-4 parent authority from the format-5 sections; and pass cross-reference, schema-matrix, and full repository validation before READY."
  duration 3p
  status done
  source "ADRs 0023 through 0027 normative synchronization gate"

task LINK_METADATA_CONTRACT CAUSE_REVISION_READY -> LINK_METADATA_DESIGN:
  title "Accept extensible Cause Link metadata format-6 decision set"
  description "Recover and accept the optional namespaced Link metadata requirement, embedded Cause Link semantics, format-6 canonical storage and compatibility boundary, one-namespace Candidate mutation, successor inspection schemas, typed linklog endpoints, and exact config-only migration command while keeping query and Assessment work separate."
  duration 3p
  status done
  source "Accepted requirement revision 2 and ADRs 0029 through 0031"

task FORMAT6_METADATA_STORAGE_SLICE LINK_METADATA_DESIGN -> FORMAT6_METADATA_STORAGE:
  title "Implement format-6 metadata storage and migration primitives"
  description "Add Seal v6, Provenance v2, Candidate v6, canonical bounded metadata values, exact v5 historical reading and Candidate projection, v6-only writes, upstream-change/v2 identity, complete fsck generation accounting, and the atomic config-only format-5-to-format-6 repository migration primitive without migrating the project repository."
  duration 5p
  status done
  source "Accepted ADRs 0029 and 0030"

task FORMAT6_METADATA_CLI_SLICE FORMAT6_METADATA_STORAGE -> FORMAT6_METADATA_RUNTIME:
  title "Implement format-6 metadata CLI and inspection contracts"
  description "Add one-target one-namespace link-metadata set/remove, preserve metadata through legacy add/link authoring, implement successor human and JSON inspection/comparison/linklog schemas with typed endpoints and historical projection labels, expose the exact migration command and receipt, and keep query, validator, and Assessment commands absent."
  duration 7p
  status done
  source "Accepted ADR 0031"

task FORMAT6_METADATA_NORMATIVE_SYNC FORMAT6_METADATA_RUNTIME -> FORMAT6_METADATA_READY:
  title "Synchronize format-6 metadata normative and public contracts"
  description "Update requirements, architecture, storage-format, CLI, integrations, implementation plan, help, completion, and fixed canonical/output fixtures from accepted ADRs 0029 through 0031; validate mixed v5/v6 projection, migration ambiguity, and the complete repository without performing project-repository migration."
  duration 3p
  status done
  source "Accepted ADRs 0029 through 0031 normative synchronization gate"

