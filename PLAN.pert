project SEALGRAPH:
  version 2
  title "Sealgraph initial implementation"
  as_of 2026-08-14
  duration_unit point
  velocity 1p/1d
  finish READY

milestone START:
  title "Architecture scaffold exists"
  state reached

milestone FORMAT:
  title "Canonical format locked"
  state reached

milestone NATIVE:
  title "Native vertical slice works"
  state reached

milestone DOGFOOD_R0:
  title "Hermetic native dogfood passes"
  state reached

milestone GRAPH:
  title "Stale and impact graph works"
  state reached

milestone RUNTIME:
  title "Canonical checkout can bootstrap runtime state"
  state reached

milestone DOGFOOD_R1:
  title "Tracked project dogfood passes"
  state reached

milestone HISTORY_READY:
  title "Seal history and semantic diff contracts work"
  state reached

milestone NATIVE_V2:
  title "Experimental full-hex IDs, scoped tags, and link rationale work"
  state reached

milestone CONSISTENCY:
  title "External specification consistency gate passes"
  state reached

milestone MATERIAL_IDENTITY:
  title "Seal identity excludes compulsory event metadata"
  state reached

milestone FORMAT4_DESIGN:
  title "REF-independent branching revision contract accepted"
  state reached

milestone FORMAT3_DUMP:
  title "Format-3 logical dump is available"
  state reached

milestone FORMAT4_RUNTIME:
  title "Format-4 native repository works"

milestone REVISION_DAG:
  title "Branching revision and Cause graph semantics work"

milestone TAG_READY:
  title "Rename-safe format-4 tag namespace works"

milestone FORMAT4_DOGFOOD:
  title "Tracked dogfood is explicitly converted to format 4"

milestone USABLE:
  title "Dogfood usability and inspection contracts work"

milestone DOGFOOD_R2:
  title "Recurring tracked dogfood passes"

milestone GIT:
  title "Git sidecar works"

milestone READY:
  title "Initial usable release"

task FORMAT_SPEC START -> FORMAT:
  title "Lock canonical payload, REF grammar, and object IDs"
  duration 2p
  status done

task NATIVE_SLICE FORMAT -> NATIVE:
  title "Implement standalone init/add/link/seal/show/status"
  duration 5p
  status done

task DOGFOOD_HERMETIC NATIVE -> DOGFOOD_R0:
  title "Exercise Phase 1 in a temporary repository"
  duration 1p
  status done

task GRAPH_ENGINE DOGFOOD_R0 -> GRAPH:
  title "Implement DAG validation, stale propagation, and impact"
  duration 4p
  status done

task RUNTIME_BOOTSTRAP GRAPH -> RUNTIME:
  title "Bootstrap ignored runtime directories from canonical checkout"
  duration 1p
  status done

task DOGFOOD_TRACKED RUNTIME -> DOGFOOD_R1:
  title "Add explicitly approved tracked project provenance"
  duration 1p
  status done

task NATIVE_V2_SLICE HISTORY_READY -> NATIVE_V2:
  title "Implement ADR 0006 and seal its dogfood provenance"
  duration 4p
  status done

task EXTERNAL_SPEC_GATE NATIVE_V2 -> CONSISTENCY:
  title "Accept and enforce publication, draft, candidate, and safe-output contracts"
  duration 5p
  status done

task MATERIAL_IDENTITY_V3 CONSISTENCY -> MATERIAL_IDENTITY:
  title "Implement ADR 0009 and regenerate tracked format-3 provenance"
  duration 3p
  status done

task ADR11_DESIGN MATERIAL_IDENTITY -> FORMAT4_DESIGN:
  title "Accept REF-independent Seals, branching revisions, and Git tree-view boundary"
  duration 2p
  status done

task FORMAT3_LOGICAL_DUMP FORMAT4_DESIGN -> FORMAT3_DUMP:
  title "Add deterministic read-only format-3 logical dump"
  duration 3p
  status done

task FORMAT4_NATIVE_CORE FORMAT3_DUMP -> FORMAT4_RUNTIME:
  title "Implement format-4 canonical Seal, candidate, selector, and dump/load core"
  duration 6p

task FORMAT4_REVISION_GRAPH FORMAT4_RUNTIME -> REVISION_DAG:
  title "Implement active revision DAG, derive/add-parent, stale cache/scan, history, and impact"
  duration 6p

task TAG_CONTRACT REVISION_DAG -> TAG_READY:
  title "Resolve rename-safe format-4 tag namespace and REF mv transaction (SG-BL-010)"
  duration 2p

task FORMAT4_DOGFOOD_LOAD TAG_READY -> FORMAT4_DOGFOOD:
  title "Convert tracked dogfood by explicit dump/load and exercise a sibling revision"
  duration 2p

task CONTENT_INGEST FORMAT4_DOGFOOD -> USABLE:
  title "Add exact file input and deterministic manifests (SG-BL-001/002)"
  duration 3p

task HISTORY_INSPECTION DOGFOOD_R1 -> HISTORY_READY:
  title "Add log, linklog, and semantic diff (SG-BL-003/004)"
  duration 4p
  status done

task OPERATOR_CONTRACT FORMAT4_DOGFOOD -> USABLE:
  title "Clarify semantics, output, and link-message editing (SG-BL-005/006/007/011)"
  duration 3p

task DOGFOOD_RECURRING USABLE -> DOGFOOD_R2:
  title "Exercise recurring tracked workflow (SG-BL-008)"
  duration 1p

task GIT_SIDECAR DOGFOOD_R2 -> GIT:
  title "Implement staged/commit tree validation, hook dispatch, and merge-stage inspection"
  duration 6p

task RELEASE_GATE GIT -> READY:
  title "Add fsck, integration tests, docs, and release checks"
  duration 3p
